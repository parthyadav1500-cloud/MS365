# Copy to .env.local for local runs, and add the same keys in Vercel > Project > Settings > Environment Variables.

# Free option: a Google Gemini API key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=
# Optional: which Gemini model the trainer uses
GEMINI_MODEL=gemini-3.5-flash

# Paid alternative: used only when GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional but recommended: a passcode the app asks for once, so strangers can't use up your quota
ACCESS_CODE=
